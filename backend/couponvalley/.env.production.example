# ─────────────────────────────────────────────────────────────────────────────
# ClipUpp backend — production env vars
# Copy these into Railway → Backend service → Variables. Values that start with
# ${{ Postgres.* }} are Railway reference variables — they auto-resolve to the
# Postgres service's runtime values, so you never paste a credential by hand.
# ─────────────────────────────────────────────────────────────────────────────

# ── Spring profile ──────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Port (Railway injects $PORT; SERVER_PORT picks it up via application.yml)
SERVER_PORT=${{ PORT }}

# ── Database (uses Railway's private-network host: zero-cost, never leaves
# Railway's network). Make sure the Postgres service has private networking
# enabled and is in the same project as the backend service.
DB_URL=jdbc:postgresql://${{ Postgres.PGHOST }}:${{ Postgres.PGPORT }}/${{ Postgres.PGDATABASE }}
DB_USERNAME=${{ Postgres.PGUSER }}
DB_PASSWORD=${{ Postgres.PGPASSWORD }}
DB_POOL_SIZE=15

# ── Auth ────────────────────────────────────────────────────────────────────
# 32+ byte random secret. Generate locally:
#   openssl rand -base64 48
JWT_SECRET=REPLACE_ME_WITH_32_PLUS_BYTE_RANDOM_SECRET
COOKIE_SECURE=true

# ── CORS — comma-separated origins that may hit the backend directly from a
# browser. With the Next.js rewrite contract the browser only ever sees the
# Vercel origin, but we still allowlist it for defence in depth.
CORS_ALLOWED_ORIGINS=https://clipupp.com,https://www.clipupp.com,https://clipupp.vercel.app

# ── URLs (used in email links, OG metadata, sitemap absolute URLs) ──────────
PUBLIC_SITE_URL=https://clipupp.com
API_BASE_URL=https://api.clipupp.com

# ── Email (Resend) ──────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
EMAIL_FROM=no-reply@clipupp.com
RESEND_API_KEY=re_REPLACE_ME

# ── Cloudflare R2 (S3-compatible object store for media uploads) ────────────
R2_BUCKET=clipupp-prod
R2_PUBLIC_BASE_URL=https://media.clipupp.com
R2_ENDPOINT=https://REPLACE.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY=REPLACE_ME
R2_SECRET_KEY=REPLACE_ME

# ── Google OAuth (used by /api/v1/auth/oauth2/google) ───────────────────────
GOOGLE_CLIENT_ID=REPLACE.apps.googleusercontent.com

# ── JVM (already baked into the Dockerfile ENTRYPOINT; override only if
# you need a different heap policy than MaxRAMPercentage=75).
# JAVA_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=70
