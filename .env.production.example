# =============================================================================
# Clipupp — Production environment variables (template)
# -----------------------------------------------------------------------------
# Copy this file to your hosting provider's secrets store. NEVER commit a
# filled-in copy. Variables prefixed `NEXT_PUBLIC_*` are inlined into the
# browser bundle — only put non-secret values there.
# =============================================================================


# ── BACKEND (Railway) ────────────────────────────────────────────────────────

# Spring profile — must be exactly "prod" in production
SPRING_PROFILES_ACTIVE=prod

# Railway injects $PORT; we map it onto Spring's SERVER_PORT
SERVER_PORT=${{ PORT }}

# Database — point at Railway's managed Postgres via reference variables
DB_URL=jdbc:postgresql://${{ Postgres.PGHOST }}:${{ Postgres.PGPORT }}/${{ Postgres.PGDATABASE }}
DB_USERNAME=${{ Postgres.PGUSER }}
DB_PASSWORD=${{ Postgres.PGPASSWORD }}
DB_POOL_SIZE=25

# JWT — generate with `openssl rand -base64 48` (≥ 32 bytes after decode)
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING

# URLs (used by the backend for OG image building, email links, CORS)
PUBLIC_SITE_URL=https://your-vercel-domain.example
API_BASE_URL=https://your-railway-domain.up.railway.app
CORS_ALLOWED_ORIGINS=https://your-vercel-domain.example

# Cookies — must be true in prod (HTTPS only)
COOKIE_SECURE=true

# Email (Resend) — set provider to "logging" if you want to defer wiring
EMAIL_PROVIDER=resend
EMAIL_FROM=no-reply@your-verified-domain.example
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Object storage (Cloudflare R2 or any S3-compatible store)
R2_BUCKET=couponvalley-media
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
R2_ENDPOINT=https://xxxxxxxxxxxxxxxx.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY=xxxxxxxxxxxxxxxx
R2_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth — same client ID the frontend uses
GOOGLE_CLIENT_ID=xxxxxxxxxxxxx.apps.googleusercontent.com

# Optional rate-limit tuning (defaults: 120 req / 60s per IP on public GETs)
# CLIPUPP_RATELIMIT_PUBLIC_PER_MIN=120
# CLIPUPP_RATELIMIT_WINDOW_SECONDS=60


# ── FRONTEND (Vercel) ────────────────────────────────────────────────────────

# Server-side proxy target — must be the Railway backend public URL with https://
BACKEND_URL=https://your-railway-domain.up.railway.app

# Site URL — used for canonical, OG, sitemap links
NEXT_PUBLIC_SITE_URL=https://your-vercel-domain.example

# Browser fetch base — leave empty so /api/v1/* stays same-origin via the
# next.config.mjs rewrite. Setting this would bypass the rewrite + lose
# cookie-on-Vercel-origin.
NEXT_PUBLIC_API_BASE_URL=

# Google OAuth client ID (public — fine to inline in the bundle)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxxx.apps.googleusercontent.com
