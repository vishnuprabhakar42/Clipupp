# ─────────────────────────────────────────────────────────────────────────────
# ClipUpp frontend — production env vars (Vercel)
# Add these in Vercel → Project → Settings → Environment Variables, scope =
# Production (and Preview if you want deploy previews to hit the same API).
# ─────────────────────────────────────────────────────────────────────────────

# ── Server-side API base — used by next.config.mjs rewrites and direct
# server-component fetches. This is the *internal* contract: the browser
# never sees this URL because /api/v1/* is rewritten to it server-side.
BACKEND_URL=https://api.clipupp.com

# ── Public API base — exposed to client JS. With the rewrite contract the
# browser hits the same Vercel origin and this value is effectively unused
# at runtime, but a couple of legacy fetches still read it. Keep it pointed
# at the Vercel origin so it never accidentally CORS-leaks the Railway URL.
NEXT_PUBLIC_API_BASE_URL=https://clipupp.com

# ── Optional. Off by default; flip on locally with `ANALYZE=true npm run build`
# to produce bundle visualisations under .next/analyze.
# ANALYZE=false
