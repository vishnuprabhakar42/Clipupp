# Rendered by CD from the GitHub production environment; this example documents the keys. Secrets: POSTGRES_PASSWORD DB_USERNAME DB_PASSWORD JWT_SECRET RESEND_API_KEY R2_ACCESS_KEY R2_SECRET_KEY RCLONE_CONFIG_R2_ACCESS_KEY_ID RCLONE_CONFIG_R2_SECRET_ACCESS_KEY TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID. Everything else is a GitHub variable.
IMAGE_TAG=sha-0000000
POSTGRES_PASSWORD=
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
PUBLIC_SITE_URL=https://clipupp.com
API_BASE_URL=https://clipupp.com
CORS_ALLOWED_ORIGINS=https://clipupp.com
EMAIL_PROVIDER=resend
EMAIL_FROM=Clipupp <hello@clipupp.com>
RESEND_API_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
GOOGLE_CLIENT_ID=
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=
BACKUP_BUCKET=clipupp-backups
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DB_POOL_SIZE=10
COOKIE_SECURE=true
R2_REGION=auto
EDGE_NETWORK=r2r_default
BACKUP_RETAIN_DAYS=30
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
DB_URL=jdbc:postgresql://db:5432/clipupp_db
POSTGRES_USER=
POSTGRES_DB=clipupp_db
